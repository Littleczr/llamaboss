<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Bundled python3 (Contents/Resources/python-runtime/bin). Packages the user approves
     are pip-installed into LlamaBoss's environment and carry other
     developers' (or ad-hoc) signatures; the hardened runtime's library
     validation would refuse to load them (e.g. PyMuPDF's _mupdf.so). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
